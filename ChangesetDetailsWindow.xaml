<Window x:Class="MergeHelper.ChangesetDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changeset" Height="560" Width="900" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Benutzer:" Margin="0,0,10,4" FontWeight="SemiBold" />
            <TextBlock x:Name="UserText" Grid.Column="1" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="Datum:" Margin="0,0,10,4" FontWeight="SemiBold" />
            <TextBlock x:Name="DateText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" />
            <TextBlock Grid.Row="2" Text="Kommentar:" Margin="0,0,10,4" FontWeight="SemiBold" />
            <TextBox x:Name="CommentBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap"
                     AcceptsReturn="True" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
        </Grid>
        <TextBlock x:Name="CountText" DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="DimGray" />
        <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Änderung" Binding="{Binding ChangeType}" Width="160" />
                <DataGridTextColumn Header="Datei / Pfad" Binding="{Binding Path}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
