<Window x:Class="MergeHelper.BranchPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Branch-Paar" Width="700" SizeToContent="Height" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Quelle:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox x:Name="SourceBox" Grid.Column="1" Margin="0,0,0,8" IsEditable="True" IsTextSearchEnabled="True"
                  FontFamily="Consolas" SelectionChanged="SourceBox_SelectionChanged" />
        <Button Grid.Column="2" Grid.RowSpan="2" Content="⇅" ToolTip="Richtung tauschen" MinWidth="0"
                Margin="8,0,0,8" Padding="8,0" FontSize="16" Click="Swap_Click" />

        <TextBlock Grid.Row="1" Text="Ziel:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox x:Name="TargetBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsEditable="True"
                  IsTextSearchEnabled="True" FontFamily="Consolas" DropDownOpened="TargetBox_DropDownOpened" />

        <CheckBox x:Name="AllTargetsCheck" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                  Content="Alle Branches als Ziel anbieten (sonst nur Parent/Children der Quelle)"
                  Checked="AllTargets_Changed" Unchecked="AllTargets_Changed" />

        <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.ColumnSpan="3" Foreground="DarkRed" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button Content="Abbrechen" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
